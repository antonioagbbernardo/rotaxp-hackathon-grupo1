# Copie para .env local e preencha apenas as integrações que utilizar.
# Nunca coloque credenciais no frontend ou no Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NEWSAPI_API_KEY=
NEWSAPI_LIMITE_DIARIO=20
SECRET_KEY=
# A primeira conta criada por criar-acesso desativa admin/admin automaticamente.
PULSE_DEMO_LOGIN=1
# Use 1 quando servir a aplicação por HTTPS.
PULSE_COOKIE_SECURE=0
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
